# ---- Runtime ----
NODE_ENV=development

# ---- API (NestJS) ----
API_PORT=3001

# ---- Admin (Next.js) ----
ADMIN_PORT=3002

# ---- AI service (FastAPI) ----
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# ---- PostgreSQL ----
POSTGRES_USER=autogenius
POSTGRES_PASSWORD=autogenius_dev_password
POSTGRES_DB=autogenius
DATABASE_URL=postgresql://autogenius:autogenius_dev_password@localhost:5432/autogenius

# ---- Redis ----
# Provisioned by docker-compose but not yet connected to by any application code.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth ----
# Generate with: openssl rand -hex 32   (min 32 chars; never commit real secrets)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
# Token lifetimes, e.g. 15m, 2h, 30d, 1w
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Rate limiting for auth endpoints (per client IP, sliding window)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_REFRESH_MAX=10

# ---- Mobile (Expo) ----
# Base URL the app uses to reach the API. Falls back per platform
# (Android emulator: http://10.0.2.2:3001, otherwise http://localhost:3001).
# Use your LAN IP (e.g. http://192.168.1.5:3001) for physical devices.
EXPO_PUBLIC_API_URL=

# ---- Qwen AI ----
# Optional until Task 06 (AI assistant): leave both values empty.
# A non-empty QWEN_BASE_URL must be a valid URL.
QWEN_API_KEY=
QWEN_BASE_URL=
