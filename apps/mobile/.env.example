# Copy to apps/mobile/.env (same directory as this file) — Expo only reads env
# files from the directory it was started in, which is always apps/mobile here.
# Restart `npx expo start` after editing: these values are inlined by Metro.

# Base URL the app uses to reach the API. Leave empty to let the app derive it:
#   1. this value, if set;
#   2. while served by the Expo CLI, the computer hosting the dev server plus
#      port 3001 (works for a device on the same Wi-Fi, no IP to keep current);
#   3. http://10.0.2.2:3001 on the Android emulator, http://localhost:3001 otherwise.
# Set it explicitly when the API does not run on port 3001 of that host.
EXPO_PUBLIC_API_URL=
